    {
      "id": "5AeNgmQQMc3eUolirBICt",
      "type": "text",
      "x": 498.51160691303414,
      "y": 2949.644005430523,
      "width": 271.37384033203125,
      "height": 38.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
